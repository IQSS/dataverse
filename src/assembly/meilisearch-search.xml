<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>meilisearch-search</id>
    <formats>
        <format>jar</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <fileSet>
            <directory>${project.build.outputDirectory}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>edu/harvard/iq/dataverse/search/MeilisearchSearchServiceBean.class</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>src/main/resources/META-INF/meilisearch-search</directory>
            <outputDirectory>META-INF/services</outputDirectory>
            <includes>
                <include>edu.harvard.iq.dataverse.search.SearchService</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
